# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) for migrations.
# URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres:<encoded-password>@db.<project-ref>.supabase.co:5432/postgres"
# Use the session pooler for app runtime if you need IPv4 connectivity.
# Correct runtime form: postgresql://postgres.<project-ref>:<encoded-password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_POOLER_URL=

# If direct DB host access is unavailable for migrations, point Alembic here.
# Use only when you cannot connect to the direct host from this machine.
DATABASE_MIGRATION_URL=

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
